{
  "name": "digital-card-os-desktop",
  "version": "0.1.0",
  "description": "Digital Card OS desktop shell",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "id.digitalcard.os",
    "productName": "Digital Card OS",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "offline.html", "package.json"],
    "win": { "target": ["nsis"], "artifactName": "Digital-Card-OS-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}