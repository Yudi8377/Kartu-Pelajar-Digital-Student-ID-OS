# Server-side only. Never prefix these values with NEXT_PUBLIC_.
# Use a development-only Neon database connection string in .env.local.
DATABASE_URL=

# Neon Managed Auth URL for the target branch (include the /auth path).
NEON_AUTH_BASE_URL=
# Generate a unique secret of at least 32 characters; store it only in host secrets.
NEON_AUTH_COOKIE_SECRET=
