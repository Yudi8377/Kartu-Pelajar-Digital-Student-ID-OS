# Server-side database credential. Never prefix with NEXT_PUBLIC_.
# Use a development-only Neon role/connection string, not the database owner.
DATABASE_URL=

# Neon Auth URL for the branch you are developing against.
# This sample URL is for the isolated development/rehearsal branch only.
# Replace it with the base URL returned by Neon for the selected branch.
NEON_AUTH_BASE_URL=https://ep-plain-hill-b30wylis.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth

# Generate a unique high-entropy secret (at least 32 characters) and keep it
# only in your local environment / deployment secret manager.
NEON_AUTH_COOKIE_SECRET=

# Public origin of this Next.js application, used by the browser auth client.
NEXT_PUBLIC_APP_URL=http://localhost:3000
